<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- The actual Office/Excel web content -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Transparent layer that turns touch drags into virtual mouse movement.
         Set to GONE when "direct touch" mode is toggled on, so touches pass
         straight through to the WebView underneath. -->
    <View
        android:id="@+id/touchPad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- The virtual mouse cursor -->
    <ImageView
        android:id="@+id/cursor"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/cursor"
        android:elevation="12dp"
        android:importantForAccessibility="no" />

    <!-- Floating, draggable, collapsible control bar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:background="@drawable/toolbar_bg"
        android:padding="2dp"
        android:elevation="14dp">

        <!-- Drag this to move the whole toolbar out of the way -->
        <TextView
            android:id="@+id/btnDragHandle"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="≡"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:contentDescription="Drag toolbar" />

        <!-- Tap to collapse/expand the rest of the buttons -->
        <TextView
            android:id="@+id/btnCollapseToggle"
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:contentDescription="Collapse toolbar" />

        <LinearLayout
            android:id="@+id/toolbarButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/btnBack"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:contentDescription="Back" />

            <ImageButton
                android:id="@+id/btnReload"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#FFFFFF"
                android:contentDescription="Reload" />

            <ImageButton
                android:id="@+id/btnMouseToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:tint="#FFFFFF"
                android:contentDescription="Toggle virtual mouse" />

            <ImageButton
                android:id="@+id/btnKeyboard"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#FFFFFF"
                android:contentDescription="Show keyboard" />

            <TextView
                android:id="@+id/btnZoomOut"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:contentDescription="Zoom out (fit more on screen)" />

            <TextView
                android:id="@+id/btnZoomIn"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:contentDescription="Zoom in" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
